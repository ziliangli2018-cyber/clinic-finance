APP_ENV=development
ALLOW_MOCK_DATA=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
# Never expose the service role key or future provider credentials through VITE_*.

# Production connected banking. Store these with `supabase secrets set`, never in Git.
# APP_ENV=production
# ALLOW_MOCK_DATA=false
# BASIQ_ENABLED=true
# BASIQ_BUSINESS_ONBOARDING_APPROVED=true
# BASIQ_API_KEY=server-side-key-from-basiq
# BASIQ_ALLOWED_INSTITUTION_IDS=AU01001,AU20130
# BASIQ_AUTOMATIC_SYNC=true
# BANK_SYNC_SCHEDULER_SECRET=generate-at-least-32-random-characters
# BASIQ_BUSINESS_PROFILE={"businessName":"...","businessIdNo":"...","businessIdNoType":"ABN","businessAddress":{"addressLine1":"...","suburb":"...","state":"QLD","postcode":"...","countryCode":"AUS"},"verificationStatus":true,"verificationDate":"DD/MM/YYYY"}
